# ============ Orchestrator (Railway service A) ============
PORT=3101
# Local dev (from services/orchestrator cwd): ../../data/registry.json
# Railway with volume on /app/data: REGISTRY_PATH=/app/data/registry.json
REGISTRY_PATH=../../data/registry.json

# GitLab webhook — must match "Secret token" in GitLab webhook UI (header x-gitlab-token)
GITLAB_WEBHOOK_SECRET=

# Server-to-server: set on orchestrator AND router (router calls GET /api/previews/:slug)
INTERNAL_API_TOKEN=

# Local only: allow GET /api/* without login (never in production with sensitive previews)
PUBLIC_READ_API=1

# Dev only: skip OAuth + session requirements (never in production)
AUTH_DISABLED=1

# --- Session (required when AUTH_DISABLED is not set) — use the SAME values on router ---
# Any passphrase 32+ UTF-8 bytes; orchestrator and router must match.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Optional; defaults to SESSION_SECRET
# COOKIE_SECRET=

# --- Google OAuth (orchestrator) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL of THIS orchestrator (no trailing slash). Google callback = {this}/auth/google/callback
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:3101
# Comma-separated extra origins allowed for ?return_to= after login (e.g. http://127.0.0.1:3102)
AUTH_TRUSTED_RETURN_ORIGINS=http://127.0.0.1:3102,http://localhost:3102

# Allowlist: comma-separated email domains (no @) and/or full emails
AUTH_ALLOWED_EMAIL_DOMAINS=flotilla.space
AUTH_ALLOWED_EMAILS=

# Stub preview targets until real Railway deploy exists
PREVIEW_TARGET_URL_TEMPLATE=https://preview-{slug}.example.invalid

# CORS — dev dashboard on Vite; production same-origin can omit
# CORS_ORIGIN=http://localhost:5173

# Optional explicit path to built dashboard (default: apps/dashboard/dist next to dist)
# DASHBOARD_DIST=

# --- GitLab site catalog (branch list per repo) ---
# GITLAB_URL=https://gitlab.flotilla.space
# Personal access token with read_api (and read_repository if needed)
# GITLAB_ACCESS_TOKEN=
# Optional: comma-separated path_with_namespace (overrides config/site-projects.json)
# GITLAB_SITE_PROJECTS=web/landing-page,web/trades
# SITE_PROJECTS_CONFIG=/absolute/path/to/site-projects.json

# ============ Preview router (Railway service B) ============
# ORCHESTRATOR_URL=http://127.0.0.1:3101
# PORT=3102
# AUTH_DISABLED=1
# Same SESSION_SECRET (and COOKIE_SECRET if set) as orchestrator
# AUTH_ISSUER_URL=http://127.0.0.1:3101
# Same allowlists as orchestrator
# AUTH_ALLOWED_EMAIL_DOMAINS=flotilla.space
# AUTH_ALLOWED_EMAILS=
